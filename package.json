{
  "name": "paking-int2",
  "version": "1.0.0",
  "description": "Sistema Inteligente de Gestión de Estacionamientos - PWA Offline-First + Cloudflare Workers & D1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:workers:coverage",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:workers:coverage": "vitest run --config vitest.workers.config.ts --coverage",
    "db:local:init": "node scripts/db/init-local.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json",
    "lint": "eslint .",
    "worker:dev": "npm run build && node scripts/dev-worker.mjs",
    "worker:deploy": "npm run build && wrangler deploy src/server/index.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "idb": "^8.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.1"
  }
}
